# Copy thành .env rồi sửa cho phù hợp server: cp .env.example .env

# IP hoặc domain dùng để truy cập CVAT trên trình duyệt (http://<CVAT_HOST>:8080)
CVAT_HOST=localhost

# Phiên bản image CVAT (khớp với submodule cvat/)
CVAT_VERSION=v2.76.0

# Docker network của CVAT mà Nuclio function sẽ join
CVAT_NETWORK=cvat_cvat
